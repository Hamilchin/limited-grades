{
  "name": "limited-grades-local",
  "private": true,
  "version": "0.1.0",
  "description": "A local clone of limitedgrades.com plus a tier list maker for your own rankings",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data": "node scripts/build-data.ts",
    "build:pages": "tsc --noEmit && VITE_STATIC_DATA=1 vite build && cp dist/index.html dist/404.html",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.2",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.9"
  }
}
